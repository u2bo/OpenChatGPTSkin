      "source": "https://cdn.jsdelivr.net/npm/@tabler/icons@3.46.0/icons/outline/rocket.svg"
    },
    {
      "file": "assets/orbitron-latin-700-normal.woff2",
      "licenseId": "OFL-1.1",
      "attribution": "Orbitron Project Authors; WOFF2 distribution by Fontsource",
      "source": "https://cdn.jsdelivr.net/npm/@fontsource/orbitron@5.3.0/files/orbitron-latin-700-normal.woff2"
    }
  ]
}
